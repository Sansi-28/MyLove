{
  "expo": {
    "name": "Kaju & Santosh 💕",
    "slug": "kaju-santosh-love",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#fff0f5",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.santosh.kajuandlove",
      "adaptiveIcon": {
        "backgroundColor": "#ffe4ef",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "@notifee/react-native",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ff69b4"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to create memories and couple art."
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "eee2c84a-26ad-4d40-b135-1ca358bedb1f"
      }
    }
  }
}
