# ═══════════════════════════════════════════
# 🔑 Template Environment Variables
# ═══════════════════════════════════════════
# Copy this file to .env and insert your actual API keys.
# Do NOT commit your actual .env file to Git!

# Pollinations AI Secret Key (Primary Image & Vision Engine)
EXPO_PUBLIC_POLLINATIONS_API_KEY=your_pollinations_api_key_here

# OpenAI API Key (Optional / Fallback)
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here
