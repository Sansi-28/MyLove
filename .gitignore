# ═══════════════════════════════════════════
# 🙈 Git Ignore — Kaju & Santosh Love App
# ═══════════════════════════════════════════

# 🔑 Secrets & Environment Variables (CRITICAL)
.env
.env.*
!.env.example
*.env
*.env.local

# 📦 Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 🚀 Expo & Metro
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# 📱 Native Android / iOS Build Outputs & Keystores
*.orig.*
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision
*.apk
*.aab
*.ipa

# EAS Build Artifacts
*.tar.gz
build-*.log

# Generated Native Prebuild Folders (managed by Expo)
/android
/ios
modules/**/build/

# 💻 Editor & IDE Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.claude/
.gemini/

# 🖥️ OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 📄 Typescript
*.tsbuildinfo

# 🧪 Temporary / Cache Files
*.log
*.tmp
.cache/
